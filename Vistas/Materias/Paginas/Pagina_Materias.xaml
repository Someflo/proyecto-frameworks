<Page x:Class="Registro_Estudianes_36.Vistas.Materias.Paginas.Pagina_Materias"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Materias" Background="#373737">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Recursos/estilos_colores.xaml"/>
                <ResourceDictionary Source="/Recursos/estilos_boton.xaml"/>
                <ResourceDictionary Source="/Recursos/estilos_label.xaml"/>
                <ResourceDictionary Source="/Recursos/estilos_textbox.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Left" Width="300" Margin="10">
            <Label Content="Clave de Materia:" Foreground="White" FontSize="13" Margin="0,0,0,2"/>
            <TextBox Height="28" Width="280" HorizontalAlignment="Left" Margin="0,0,0,10" Style="{StaticResource RoundedTextBoxStyle}"/>

            <Label Content="Nombre de Materia:" Foreground="White" FontSize="13" Margin="0,0,0,2"/>
            <TextBox Height="28" Width="280" HorizontalAlignment="Left" Margin="0,0,0,10" Style="{StaticResource RoundedTextBoxStyle}"/>

            <Label Content="Créditos:" Foreground="White" FontSize="13" Margin="0,0,0,2"/>
            <TextBox Height="28" Width="280" HorizontalAlignment="Left" Margin="0,0,0,10" Style="{StaticResource RoundedTextBoxStyle}"/>

            <Label Content="Profesor Asignado:" Foreground="White" FontSize="13" Margin="0,0,0,2"/>
            <TextBox Height="28" Width="280" HorizontalAlignment="Left" Margin="0,0,0,10" Style="{StaticResource RoundedTextBoxStyle}"/>

            <Label Content="Horario:" Foreground="White" FontSize="13" Margin="0,0,0,2"/>
            <TextBox Height="28" Width="280" HorizontalAlignment="Left" Margin="0,0,0,10" Style="{StaticResource RoundedTextBoxStyle}"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10">
            <Button Content="Ingresar" Style="{StaticResource BotonSimple}"/>
            <Button Content="Eliminar" Style="{StaticResource BotonSimple}"/>
            <Button Content="Guardar" Style="{StaticResource BotonSimple}"/>
        </StackPanel>
    </Grid>
</Page>
