    <SolidColorBrush x:Key="MC_TextShadow" Color="#3F3F3F"/>
    <SolidColorBrush x:Key="MC_BorderDark" Color="#000000"/>
    <SolidColorBrush x:Key="MC_ShadowLow" Color="#373737"/>
    <SolidColorBrush x:Key="MC_HighlightHi" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="MC_BaseGray" Color="#707070"/>
    <SolidColorBrush x:Key="MC_HoverGray" Color="#8B8B8B"/>
