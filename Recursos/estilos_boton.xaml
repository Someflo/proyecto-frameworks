<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Recursos/estilos_colores.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="ModernButton" TargetType="Button">
        <Setter Property="Background" Value="DarkGreen"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" 
                            Background="{TemplateBinding Background}" 
                            CornerRadius="8" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            Padding="15,8">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Efecto cuando el mouse pasa por encima -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="ForestGreen"/>
                        </Trigger>
                        <!-- Efecto cuando se presiona el boton -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="LawnGreen"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MinecraftSideButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="50"/>
        <Setter Property="Margin" Value="6,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource MC_TextWhite}"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- Contorno exterior negro tipo "borde de bloque" -->
                        <Border x:Name="OuterBorder"
                                Background="{StaticResource MC_BorderDark}"
                                SnapsToDevicePixels="True">

                            <!-- Franja de luz (arriba/izquierda) + sombra (abajo/derecha): bisel pixelado -->
                            <Grid Margin="2">
                                <Border x:Name="ShadowEdge"
                                        Background="{StaticResource MC_ShadowLow}"
                                        Margin="2,2,0,0"/>
                                <Border x:Name="HighlightEdge"
                                        Background="{StaticResource MC_HighlightHi}"
                                        Margin="0,0,2,2"/>

                                <!-- Cara principal del botón -->
                                <Border x:Name="Face"
                                        Background="{StaticResource MC_BaseGray}"
                                        Margin="2">
                                    <Border x:Name="ContentShift" Margin="0">
                                        <DockPanel Margin="10,0" LastChildFill="True">

                                            <!-- Barra de acento (aparece al presionar) -->
                                            <Border x:Name="AccentBar"
                                                    DockPanel.Dock="Left"
                                                    Width="3"
                                                    Margin="-10,0,10,0"
                                                    Background="{StaticResource MC_AccentBar}"
                                                    Opacity="0"/>

                                            <!-- "Slot" hundido para el ícono, como un inventario de Minecraft -->
                                            <Border x:Name="IconSlot"
                                                    Width="28" Height="28"
                                                    Background="{StaticResource MC_SlotBg}"
                                                    BorderThickness="1"
                                                    BorderBrush="{StaticResource MC_ShadowLow}"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center">
                                                <Image Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                       Width="20" Height="20"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                       SnapsToDevicePixels="True"/>
                                            </Border>

                                            <!-- Texto con sombra tipo pixel-font -->
                                            <Grid VerticalAlignment="Center">
                                                <TextBlock Text="{TemplateBinding Content}"
                                                           Foreground="{StaticResource MC_TextShadow}"
                                                           FontFamily="{TemplateBinding FontFamily}"
                                                           FontSize="{TemplateBinding FontSize}"
                                                           FontWeight="{TemplateBinding FontWeight}"
                                                           Margin="1,1,0,0"/>
                                                <TextBlock Text="{TemplateBinding Content}"
                                                           Foreground="{TemplateBinding Foreground}"
                                                           FontFamily="{TemplateBinding FontFamily}"
                                                           FontSize="{TemplateBinding FontSize}"
                                                           FontWeight="{TemplateBinding FontWeight}"/>
                                            </Grid>
                                        </DockPanel>
                                    </Border>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource MC_HoverGray}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource MC_PressedGray}"/>
                            <Setter TargetName="AccentBar" Property="Opacity" Value="1"/>
                            <!-- Simula que el bloque se "hunde" al presionar -->
                            <Setter TargetName="ContentShift" Property="Margin" Value="1,1,0,0"/>
                            <Setter TargetName="HighlightEdge" Property="Opacity" Value="0.4"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource MC_LightGray}"/>
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- ESTILOS NUEVOS: Estructura tipo app del amigo, tema Minecraft -->
    <!-- ============================================================ -->

    <!-- Estilo para RadioButtons del menú lateral (sidebar) -->
    <Style x:Key="EstiloBotonLateral" TargetType="RadioButton">
        <Setter Property="Height" Value="45"/>
        <Setter Property="Margin" Value="4,2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="OuterBorder"
                                Background="{StaticResource MC_BorderDark}"
                                SnapsToDevicePixels="True">
                            <Grid Margin="2">
                                <Border x:Name="ShadowEdge"
                                        Background="{StaticResource MC_ShadowLow}"
                                        Margin="2,2,0,0"/>
                                <Border x:Name="HighlightEdge"
                                        Background="{StaticResource MC_HighlightHi}"
                                        Margin="0,0,2,2"/>
                                <Border x:Name="Face"
                                        Background="{StaticResource MC_BaseGray}"
                                        Margin="2">
                                    <Border x:Name="ContentShift" Margin="0">
                                        <DockPanel Margin="10,0" LastChildFill="True">
                                            <Border x:Name="AccentBar"
                                                    DockPanel.Dock="Left"
                                                    Width="3"
                                                    Margin="-10,0,10,0"
                                                    Background="{StaticResource MC_AccentBar}"
                                                    Opacity="0"/>
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource MC_HoverGray}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource MC_PressedGray}"/>
                            <Setter TargetName="AccentBar" Property="Opacity" Value="1"/>
                            <Setter TargetName="ContentShift" Property="Margin" Value="1,1,0,0"/>
                            <Setter TargetName="HighlightEdge" Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Estilo para botones redondeados superiores (acciones rápidas) -->
    <Style x:Key="EstiloBotonRedondeado" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource MC_TextWhite}"/>
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="OuterBorder"
                                Background="{StaticResource MC_BorderDark}"
                                SnapsToDevicePixels="True">
                            <Grid Margin="2">
                                <Border x:Name="ShadowEdge"
                                        Background="{StaticResource MC_ShadowLow}"
                                        Margin="2,2,0,0"/>
                                <Border x:Name="HighlightEdge"
                                        Background="{StaticResource MC_HighlightHi}"
                                        Margin="0,0,2,2"/>
                                <Border x:Name="Face"
                                        Background="{TemplateBinding Background}"
                                        Margin="2"
                                        Padding="15,6">
                                    <Grid>
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   Foreground="{StaticResource MC_TextShadow}"
                                                   FontFamily="{TemplateBinding FontFamily}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   FontWeight="{TemplateBinding FontWeight}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Margin="1,1,0,0"/>
                                        <TextBlock Text="{TemplateBinding Content}"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   FontFamily="{TemplateBinding FontFamily}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   FontWeight="{TemplateBinding FontWeight}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource MC_HoverGray}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource MC_PressedGray}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Estilo para los contenedores (Borders) de la cuadrícula central -->
    <Style x:Key="EstiloContenedor" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource MC_BaseGray}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MC_BorderDark}"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Estilo para RadioButtons dentro de la cuadrícula -->
    <Style x:Key="EstiloRadioButtonCuadricula" TargetType="RadioButton">
        <Setter Property="Width" Value="70"/>
        <Setter Property="Height" Value="70"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Face"
                            Background="Transparent"
                            Padding="10">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource MC_HoverGray}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource MC_PressedGray}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                             To="85"
                                             Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="Height"
                                             To="85"
                                             Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Width"
                                             To="70"
                                             Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="Height"
                                             To="70"
                                             Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    
    <Style x:Key="BotonSimple" TargetType="Button">
        <Setter Property="Height" Value="22"/>
        <Setter Property="Width"  Value="110"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,26"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="FontWeight" Value="Regular"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush EndPoint="0,0" StartPoint="1,1">
                    <GradientStop Color="#34495e" Offset="0"/>
                    <GradientStop Color="#2980b9" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Width"
                                     To="120"
                                     Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetProperty="Height"
                                     To="32"
                                     Duration="0:0:0.2"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>

            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Width"
                                     To="110"
                                     Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetProperty="Height"
                                     To="22"
                                     Duration="0:0:0.2"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>

            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background">
                    <Setter.Value>
                        <LinearGradientBrush EndPoint="0,0" StartPoint="1,1">
                            <GradientStop Color="red" Offset="0.0"/>
                            <GradientStop Color="Orange" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

