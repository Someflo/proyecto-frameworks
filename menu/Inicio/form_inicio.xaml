<Window x:Class="Registro_Estudianes_36.menu.Inicio.form_inicio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Registro_Estudianes_36.menu.Inicio"
        mc:Ignorable="d"
        Title="form_inicio" Height="450" Width="800">


    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/estilos/estilos_colores.xaml"/>
                <ResourceDictionary Source="/estilos/estilos_boton.xaml"/>
                <ResourceDictionary Source="/estilos/estilos_label.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>



    <Grid Margin="20">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="200"/>
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Left" Width="250" Margin="10">
        <Label Content="Nombre del usuario:" Style="{StaticResource LabelSimple}"/>
        <TextBox Height="25" Margin="0,0,0,10" Style="{StaticResource TextBoxSimple}"/>

        <Label Content="Edad:" Style="{StaticResource LabelSimple}"/>
        <TextBox Height="25" Margin="0,0,0,10" Style="{StaticResource TextBoxSimple}"/>

        <Label Content="Correo Electronico:" Style="{StaticResource LabelSimple}"/>
        <TextBox Height="25" Margin="0,0,0,10" Style="{StaticResource TextBoxSimple}"/>

        <Label Content="Contraseña:" Style="{StaticResource LabelSimple}"/>
        <TextBox Height="25" Margin="0,0,0,10" Style="{StaticResource TextBoxSimple}"/>

        <Label Content="UUID:" Style="{StaticResource LabelSimple}"/>
        <TextBox Height="25" Margin="0,0,0,10" Style="{StaticResource TextBoxSimple}"/>

    </StackPanel>

    <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10">
        <Button Content="Ingresar" Style="{StaticResource BotonSimple}"/>
        <Button Content="Eliminar" Style="{StaticResource BotonSimple}"/>
        <Button Content="Guardar" Style="{StaticResource BotonSimple}"/>
    </StackPanel>
</Grid>
</Window>
